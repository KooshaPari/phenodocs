# Standard Phenotype Environment Template
# Duplicate this to .env and fill in required secrets.

APP_NAME=PhenotypeApp
NODE_ENV=development
API_BASE_URL=https://api.phenotype.local
DEBUG_ENABLED=true

# docslib library configuration (see libs/docslib/CONFIG.md)
# DOCSLIB_VERSION=0.1.0
# DOCSLIB_MAX_WIDTH=800px
# DOCSLIB_FONT_FAMILY=sans-serif
# DOCSLIB_BG_COLOR=#f4f4f4
# DOCSLIB_CODE_BG_COLOR=#f4f4f4
# DOCSLIB_PADDING=20px
